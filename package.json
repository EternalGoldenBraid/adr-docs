{
  "name": "adr-docs",
  "version": "0.139.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "adr": "bin/preview.mjs",
    "adr-check": "bin/check.mjs",
    "adr-vote": "bin/vote.mjs"
  },
  "description": "Local Markdown, equation and figure review with persistent Copilot session comments",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./src/preview.mjs",
    "./copilot": "./src/copilot.mjs",
    "./task-lists": "./src/task-lists.mjs",
    "./editable-tables": "./src/editable-tables.mjs",
    "./build-info": "./src/build-info.mjs",
    "./page-tree": "./src/page-tree.mjs",
    "./theme": "./src/theme/index.mjs",
    "./vite-plugin": "./scripts/preview_comments/vite-plugin.mjs",
    "./comment-bridge": "./scripts/preview_comments/server.mjs"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "example:paper": "python3 tools/fetch_arxiv.py 2211.08416v3 --root examples",
    "preview": "node bin/preview.mjs",
    "export": "node tools/export.mjs",
    "workstreams": "node tools/workstreams_index.mjs",
    "demos": "node tools/record_demos.mjs",
    "readme": "node bin/preview.mjs examples/index.md 5180",
    "build:site": "vitepress build examples"
  },
  "dependencies": {
    "@sparkjsdev/spark": "2.4.0",
    "cytoscape": "3.35.0",
    "markdown-it-mathjax3": "4.3.2",
    "three": "0.187.0",
    "vitepress": "1.6.4"
  },
  "devDependencies": {
    "playwright-core": "^1.65.0"
  }
}

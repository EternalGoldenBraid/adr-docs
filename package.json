{
  "name": "adr-docs",
  "version": "0.206.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "adr": "bin/preview.mjs",
    "adr-check": "bin/check.mjs",
    "adr-vote": "bin/vote.mjs"
  },
  "description": "Local Markdown, equation and figure review with persistent Copilot session comments",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./src/preview.mjs",
    "./copilot": "./src/copilot.mjs",
    "./task-lists": "./src/task-lists.mjs",
    "./editable-tables": "./src/editable-tables.mjs",
    "./build-info": "./src/build-info.mjs",
    "./page-tree": "./src/page-tree.mjs",
    "./theme": "./src/theme/index.mjs",
    "./vite-plugin": "./scripts/preview_comments/vite-plugin.mjs",
    "./comment-bridge": "./scripts/preview_comments/server.mjs"
  },
  "scripts": {
    "build:math": "esbuild scripts/preview_comments/math.entry.js --bundle --minify --format=iife --target=es2022 --outfile=scripts/preview_comments/math.bundle.js",
    "build:code-viewer": "esbuild scripts/code_viewer/viewer.js --bundle --minify --format=esm --target=es2022 --outfile=scripts/code_viewer/viewer.bundle.js",
    "test": "node --test tests/*.test.mjs",
    "example:paper": "python3 tools/fetch_arxiv.py 2211.08416v3 --root examples",
    "preview": "node bin/preview.mjs",
    "export": "node tools/export.mjs",
    "workstreams": "node tools/workstreams_index.mjs",
    "demos": "node tools/record_demos.mjs",
    "readme": "node bin/preview.mjs examples/index.md 5180",
    "build:site": "vitepress build examples"
  },
  "dependencies": {
    "@sparkjsdev/spark": "2.4.0",
    "cytoscape": "3.35.0",
    "markdown-it-mathjax3": "4.3.2",
    "three": "0.187.0",
    "vitepress": "1.6.4"
  },
  "devDependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@replit/codemirror-vim": "^6.4.0",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.65.0",
    "temml": "^0.14.0"
  }
}
